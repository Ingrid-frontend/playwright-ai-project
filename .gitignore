# Dependencies
node_modules/
# 各 flow 目录下指向根 node_modules 的软链。'node_modules/' 带尾斜杠只匹配目录，
# 不匹配软链，所以必须单独写一条不带斜杠的规则。
node_modules
# package-lock.json  # 移除此行，因为npm ci需要lock文件
yarn.lock
pnpm-lock.yaml

# Playwright
test-results/
playwright-report/
public-reports/
ci-artifacts/
playwright/.cache/

# Results
results/

# Screenshots (generated artifacts)
screenshots/
!screenshots/.gitkeep
screenshots-baseline/_quarantine/

# Local debug leftovers
debug-page.png
temp-script.txt
test-code.txt
# 截图比对产物（compare-screenshots 会在被比对目录里落一份 .meta.json，
# 根目录这份是手动跑单图比对时留下的）
.meta.json

# Agent 工作记忆（本地笔记，不入库）
.workbuddy/

# 前端仓库本地克隆（index:frontend 用，按环境分目录，1G+）
# 原先只忽略了 .cache/frontend-repo/，漏掉 -test-dev / -test-stage / -test-uat
.cache/

# Environment variables
.env
.env.local
.env.*.local

# Feishu configuration (contains sensitive webhook URLs)
feishu-config.json

# Datasource configuration
datasource/accounts.json
# 全量 UI 契约由 npm run index:frontend 生成；仓库只提交 datasource/ui-contract.seed.json
datasource/ui-contract.json
approval-flow/datasource/live-snapshot.json

# Login state files (contains sensitive tokens)
storage/loginState/
!storage/loginState/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Build output
dist/
build/

# Deprecated test files
tests/deprecated/

# Raw recordings / recorder outputs (may contain sensitive credentials)
tests/raw-recordings/
tests/chrome-recorder/

# Development tools
.cursor/
.trae/

# Backup files
backup/
