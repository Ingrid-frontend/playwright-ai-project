{
  "version": 1,
  "defaults": {
    "playwrightEnv": "stage",
    "projects": ["optimized", "optimized-webkit"],
    "optimizedDir": "tests/optimized",
    "stopOnTestFailure": true,
    "stopOnCompareGate": true,
    "runCompareAfterAbort": false,
    "feishuMode": "interactive",
    "notifyOn": ["failure", "success"],
    "steps": {
      "login": true,
      "compare": true,
      "compareGate": true,
      "recordLastGreen": true,
      "feishuNotify": true,
      "createFeishuDoc": false,
      "writeFeishuBitable": false,
      "refreshLogin": false
    }
  },
  "jobs": [
    {
      "id": "request-flow-golden",
      "enabled": true,
      "description": "申请单 Golden 回归（dev，golden* 角色串行跑 golden-regression）",
      "runner": "request-flow-golden",
      "schedule": null,
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": null,
      "specs": "request/golden-regression.spec.ts",
      "steps": {
        "login": false,
        "compare": false,
        "compareGate": false,
        "recordLastGreen": false,
        "feishuNotify": false,
        "createFeishuDoc": false,
        "writeFeishuBitable": false
      },
      "notifyOn": ["failure", "success"]
    },
    {
      "id": "request-flow-write",
      "enabled": true,
      "description": "申请单 Write 回归（dev，write 档案跑 travel-submit + full-flow）",
      "runner": "request-flow-write",
      "schedule": null,
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": "write",
      "specs": ["request/travel-submit.spec.ts", "request/full-flow.spec.ts"],
      "steps": {
        "login": false,
        "compare": false,
        "compareGate": false,
        "recordLastGreen": false,
        "feishuNotify": false,
        "createFeishuDoc": false,
        "writeFeishuBitable": false
      },
      "notifyOn": ["failure", "success"]
    }
  ]
}
