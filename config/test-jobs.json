{
  "version": 1,
  "defaults": {
    "playwrightEnv": "stage",
    "projects": ["optimized", "optimized-webkit"],
    "optimizedDir": "tests/optimized",
    "stopOnTestFailure": true,
    "stopOnCompareGate": true,
    "runCompareAfterAbort": false,
    "feishuMode": "interactive",
    "notifyOn": ["failure", "success"],
    "steps": {
      "login": true,
      "compare": true,
      "compareGate": false,
      "recordLastGreen": true,
      "feishuNotify": true,
      "createFeishuDoc": false,
      "refreshLogin": false
    }
  },
  "jobs": [
    {
      "id": "nightly-regression",
      "enabled": true,
      "description": "每日 Stage 全量回归",
      "schedule": "0 2 * * *",
      "timezone": "Asia/Shanghai",
      "specs": "all",
      "steps": {
        "login": true,
        "compare": true,
        "compareGate": true,
        "recordLastGreen": true,
        "feishuNotify": true,
        "createFeishuDoc": false
      },
      "notifyOn": ["failure", "success"]
    },
    {
      "id": "smoke-workbench",
      "enabled": true,
      "description": "工作台冒烟（手动或按需触发）",
      "schedule": null,
      "specs": ["tests/optimized/260612/工作台_*.optimized.spec.ts"],
      "stopOnTestFailure": true,
      "steps": {
        "login": true,
        "compare": true,
        "compareGate": false,
        "feishuNotify": true
      }
    }
  ]
}
