{
  "version": 1,
  "defaults": {
    "playwrightEnv": "stage",
    "projects": ["optimized", "optimized-webkit"],
    "optimizedDir": "tests/optimized",
    "stopOnTestFailure": true,
    "stopOnCompareGate": true,
    "runCompareAfterAbort": false,
    "feishuMode": "interactive",
    "notifyOn": ["failure", "success"],
    "steps": {
      "login": true,
      "compare": true,
      "compareGate": true,
      "recordLastGreen": true,
      "feishuNotify": true,
      "createFeishuDoc": false,
      "writeFeishuBitable": false,
      "refreshLogin": false
    }
  },
  "jobs": [
    {
      "id": "golden-set",
      "enabled": true,
      "description": "Golden Set 回归（stage：登录 → 工作台 → 我的审批）",
      "schedule": null,
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "stage",
      "accountProfile": "default",
      "specs": ["golden-set/*.optimized.spec.ts"],
      "steps": {
        "login": true,
        "compare": true,
        "compareGate": true,
        "recordLastGreen": true,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": false
      },
      "notifyOn": ["failure", "success"]
    }
  ]
}
