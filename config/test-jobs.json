{
  "version": 1,
  "defaults": {
    "playwrightEnv": "stage",
    "projects": ["optimized", "optimized-webkit"],
    "optimizedDir": "tests/optimized",
    "stopOnTestFailure": true,
    "stopOnCompareGate": true,
    "runCompareAfterAbort": false,
    "feishuMode": "interactive",
    "notifyOn": ["failure", "success"],
    "steps": {
      "login": true,
      "compare": true,
      "compareGate": true,
      "recordLastGreen": true,
      "feishuNotify": true,
      "createFeishuDoc": false,
      "writeFeishuBitable": false,
      "refreshLogin": false
    }
  },
  "jobs": [
    {
      "id": "request-flow-golden",
      "enabled": true,
      "description": "L1 申请单 Golden 回归（dev，golden* 角色串行跑 golden-regression）",
      "runner": "request-flow-golden",
      "tier": "L1",
      "schedule": null,
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": null,
      "specs": "request/golden-regression.spec.ts",
      "steps": {
        "login": true,
        "compare": true,
        "compareGate": true,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": true,
        "refreshLogin": true,
        "promoteBaselineIfClean": false,
        "deliveryPreview": true
      },
      "notifyOn": ["failure", "success"]
    },
    {
      "id": "request-flow-golden-all-envs",
      "enabled": true,
      "description": "L3 申请单 Golden 回归（全环境 golden* 角色串行跑 golden-regression，发版前手动触发）",
      "runner": "request-flow-golden",
      "tier": "L3",
      "schedule": "0 6 * * *",
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "all",
      "accountProfile": null,
      "specs": "request/golden-regression.spec.ts",
      "steps": {
        "login": true,
        "compare": true,
        "compareGate": true,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": true,
        "refreshLogin": true,
        "promoteBaselineIfClean": false,
        "deliveryPreview": true
      },
      "notifyOn": ["failure", "success"]
    },
    {
      "id": "request-flow-write",
      "enabled": true,
      "description": "申请单 Write 回归（dev，write 档案跑 travel-submit + full-flow）",
      "runner": "request-flow-write",
      "schedule": null,
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": "write",
      "specs": ["request/travel-submit.spec.ts", "request/full-flow.spec.ts"],
      "steps": {
        "login": true,
        "compare": false,
        "compareGate": false,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": false,
        "refreshLogin": true,
        "resetFlowArtifacts": true,
        "uiAuditGate": true
      },
      "notifyOn": ["failure"]
    },
    {
      "id": "approval-flow-golden",
      "enabled": true,
      "description": "L1 审批 Golden 回归（dev，golden* 角色串行跑 golden-regression，复用申请单登录态）",
      "runner": "approval-flow-golden",
      "tier": "L1",
      "schedule": null,
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": null,
      "specs": "approval/golden-regression.spec.ts",
      "steps": {
        "login": true,
        "compare": true,
        "compareGate": true,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": true,
        "refreshLogin": true,
        "promoteBaselineIfClean": false,
        "deliveryPreview": true
      },
      "notifyOn": ["failure", "success"]
    },
    {
      "id": "approval-flow-write",
      "enabled": true,
      "description": "审批 Write 回归（dev，write 档案跑 approve-reject）",
      "runner": "approval-flow-write",
      "schedule": null,
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": "write",
      "specs": ["approval/approve-reject.spec.ts"],
      "steps": {
        "login": true,
        "compare": false,
        "compareGate": false,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": false,
        "refreshLogin": true,
        "resetFlowArtifacts": true,
        "uiAuditGate": true
      },
      "notifyOn": ["failure"]
    },
    {
      "id": "expense-flow-golden",
      "enabled": false,
      "description": "L1 报销 Golden 回归（dev，复制 golden-seeds.json.example 为 golden-seeds.json 并填 expenseDocNo 后设 enabled:true）",
      "runner": "expense-flow-golden",
      "tier": "L1",
      "schedule": null,
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": null,
      "specs": "expense/golden-regression.spec.ts",
      "steps": {
        "login": true,
        "compare": true,
        "compareGate": true,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": true,
        "refreshLogin": true,
        "promoteBaselineIfClean": false,
        "deliveryPreview": true
      },
      "notifyOn": ["failure", "success"]
    },
    {
      "id": "catalog-drift-check",
      "enabled": true,
      "description": "L2 catalog 漂移检测（dev，每日 01:00 UTC=09:00 北京，先于 10:00 golden 发现 UI 变更）",
      "runner": "catalog-drift-check",
      "tier": "L2",
      "schedule": "0 1 * * *",
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": null,
      "specs": "all",
      "steps": {
        "login": false,
        "compare": false,
        "compareGate": false,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": false,
        "refreshLogin": false
      },
      "notifyOn": ["failure"]
    }
  ]
}
