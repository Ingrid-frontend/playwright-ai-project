{
  "version": 1,
  "defaults": {
    "cronTimezone": "UTC",
    "playwrightEnv": "stage",
    "projects": ["optimized", "optimized-webkit"],
    "optimizedDir": "tests/optimized",
    "stopOnTestFailure": true,
    "stopOnCompareGate": true,
    "runCompareAfterAbort": false,
    "feishuMode": "interactive",
    "notifyOn": ["failure", "success"],
    "steps": {
      "login": true,
      "compare": true,
      "compareGate": true,
      "recordLastGreen": true,
      "feishuNotify": true,
      "createFeishuDoc": false,
      "writeFeishuBitable": false,
      "refreshLogin": false
    }
  },
  "jobs": [
    {
      "id": "request-flow-golden",
      "enabled": true,
      "description": "L1 申请单 Golden 回归（dev，golden* 角色串行跑 golden-regression）",
      "runner": "request-flow-golden",
      "tier": "L1",
      "schedule": "0 2 * * 1-5",
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": null,
      "specs": "request/golden-regression.spec.ts",
      "steps": {
        "login": true,
        "compare": true,
        "compareGate": true,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": true,
        "refreshLogin": true,
        "promoteBaselineIfClean": false,
        "deliveryPreview": true
      },
      "notifyOn": ["failure", "success"]
    },
    {
      "id": "request-flow-golden-all-envs",
      "enabled": true,
      "description": "L3 申请单 Golden 回归（全环境 golden* 角色串行跑 golden-regression，发版前手动触发）",
      "runner": "request-flow-golden",
      "tier": "L3",
      "schedule": "0 22 * * *",
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "all",
      "accountProfile": null,
      "specs": "request/golden-regression.spec.ts",
      "steps": {
        "login": true,
        "compare": true,
        "compareGate": true,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": true,
        "refreshLogin": true,
        "promoteBaselineIfClean": false,
        "deliveryPreview": true
      },
      "notifyOn": ["failure", "success"]
    },
    {
      "id": "request-flow-write",
      "enabled": true,
      "description": "申请单 Write 回归（dev，write 档案跑 travel-submit + full-flow）",
      "runner": "request-flow-write",
      "schedule": "0 3 * * 2,4",
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": "write",
      "specs": ["request/travel-submit.spec.ts", "request/full-flow.spec.ts"],
      "steps": {
        "login": true,
        "compare": false,
        "compareGate": false,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": false,
        "refreshLogin": true,
        "resetFlowArtifacts": true,
        "uiAuditGate": true
      },
      "notifyOn": ["failure"]
    },
    {
      "id": "approval-flow-golden",
      "enabled": true,
      "description": "L1 审批 Golden 回归（dev，golden* 角色串行跑 golden-regression，复用申请单登录态）",
      "runner": "approval-flow-golden",
      "tier": "L1",
      "schedule": null,
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": null,
      "specs": "approval/golden-regression.spec.ts",
      "steps": {
        "login": true,
        "compare": true,
        "compareGate": true,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": true,
        "refreshLogin": true,
        "promoteBaselineIfClean": false,
        "deliveryPreview": true
      },
      "notifyOn": ["failure", "success"]
    },
    {
      "id": "approval-flow-write",
      "enabled": true,
      "description": "审批 Write 回归（dev，write 档案跑 approve-reject）",
      "runner": "approval-flow-write",
      "schedule": "0 4 * * 3",
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": "write",
      "specs": ["approval/approve-reject.spec.ts"],
      "steps": {
        "login": true,
        "compare": false,
        "compareGate": false,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": false,
        "refreshLogin": true,
        "resetFlowArtifacts": true,
        "uiAuditGate": true
      },
      "notifyOn": ["failure"]
    },
    {
      "id": "expense-flow-golden",
      "enabled": false,
      "description": "L1 报销 Golden 回归（dev，复制 golden-seeds.json.example 为 golden-seeds.json 并填 expenseDocNo 后设 enabled:true）",
      "runner": "expense-flow-golden",
      "tier": "L1",
      "schedule": null,
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": null,
      "specs": "expense/golden-regression.spec.ts",
      "steps": {
        "login": true,
        "compare": true,
        "compareGate": true,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": true,
        "refreshLogin": true,
        "promoteBaselineIfClean": false,
        "deliveryPreview": true
      },
      "notifyOn": ["failure", "success"]
    },
    {
      "id": "golden-all-flows",
      "enabled": true,
      "description": "本机定时：dev、uat、stage9084 上申请单、审批、报销、对公申请单各做一次检测全部",
      "scheduler": "local",
      "schedule": "30 10 * * 1-5",
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "envs": ["dev", "uat", "stage9084"],
      "accountProfile": null,
      "flows": ["request-flow", "approval-flow", "expense-flow", "ap-request-flow"],
      "specs": [],
      "steps": {
        "writeFeishuBitable": false,
        "uiAuditGate": false
      },
      "notifyOn": ["failure"]
    },
    {
      "id": "catalog-drift-check",
      "enabled": true,
      "description": "L2 catalog 漂移检测（dev，每日 09:00 北京，先于 10:00 golden 发现 UI 变更）",
      "runner": "catalog-drift-check",
      "tier": "L2",
      "schedule": "0 1 * * *",
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": null,
      "specs": "all",
      "steps": {
        "login": false,
        "compare": false,
        "compareGate": false,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": false,
        "refreshLogin": false
      },
      "notifyOn": ["failure"]
    },
    {
      "id": "ai-smoke-patrol",
      "enabled": false,
      "description": "L2 全站 Smoke 巡检（page-catalog 驱动，零 LLM；调参期 notifyOn=failure，放量前手动触发观察）",
      "runner": "ai-smoke-patrol",
      "tier": "L2",
      "schedule": "0 6 * * 1-5",
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": null,
      "specs": "all",
      "steps": {
        "login": false,
        "compare": false,
        "compareGate": false,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": false,
        "refreshLogin": false
      },
      "notifyOn": ["failure"]
    },
    {
      "id": "intent-batch",
      "enabled": false,
      "description": "L2 Stable Intent 回归（trustLevel=stable 且非写动作用例顺序跑；trial/watch 不进批；manual 触起步）",
      "runner": "intent-batch",
      "tier": "L2",
      "schedule": null,
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "dev",
      "accountProfile": null,
      "specs": "all",
      "steps": {
        "login": false,
        "compare": false,
        "compareGate": false,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": false,
        "refreshLogin": false
      },
      "notifyOn": ["failure"]
    }
  ]
}
