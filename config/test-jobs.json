{
  "version": 1,
  "defaults": {
    "playwrightEnv": "stage",
    "projects": ["optimized", "optimized-webkit"],
    "optimizedDir": "tests/optimized",
    "stopOnTestFailure": true,
    "stopOnCompareGate": true,
    "runCompareAfterAbort": false,
    "feishuMode": "interactive",
    "notifyOn": ["failure", "success"],
    "steps": {
      "login": true,
      "compare": true,
      "compareGate": true,
      "recordLastGreen": true,
      "feishuNotify": true,
      "createFeishuDoc": false,
      "writeFeishuBitable": false,
      "refreshLogin": false
    }
  },
  "jobs": [
    {
      "id": "nightly-regression",
      "enabled": true,
      "description": "全量回归（定时默认 stage；多账号按 meta 分组 login 后执行）",
      "schedule": "0 2 * * *",
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "stage",
      "specs": "all",
      "steps": {
        "login": true,
        "compare": true,
        "compareGate": true,
        "recordLastGreen": true,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": false
      },
      "notifyOn": ["failure", "success"]
    },
    {
      "id": "smoke-workbench",
      "enabled": true,
      "description": "stage/260612 冒烟（手动触发；Studio 可勾选子集）",
      "schedule": null,
      "playwrightEnv": "stage",
      "specs": ["260612/*.optimized.spec.ts"],
      "stopOnTestFailure": true,
      "steps": {
        "login": true,
        "compare": true,
        "compareGate": false,
        "feishuNotify": true,
        "writeFeishuBitable": false
      }
    },
    {
      "id": "approval-flow-write",
      "enabled": false,
      "description": "审批写操作（stage，APPROVAL_ENABLE_WRITE=1）；定时由 .github/workflows/approval-flow-write.yml 执行，本地可 npm run approval:test:write",
      "schedule": "0 3 * * 1",
      "timezone": "Asia/Shanghai",
      "playwrightEnv": "stage",
      "specs": "all",
      "steps": {
        "login": true,
        "compare": false,
        "compareGate": false,
        "recordLastGreen": false,
        "feishuNotify": true,
        "createFeishuDoc": false,
        "writeFeishuBitable": false
      },
      "notifyOn": ["failure"]
    }
  ]
}
