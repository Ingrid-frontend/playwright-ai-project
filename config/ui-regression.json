{
  "blockerRatio": 0.01,
  "warningRatio": 0.001,
  "diffOnlyTabMinRatio": 0.003,
  "defaultBrowsers": ["chrome"],
  "compareCrossBrowser": false,
  "compareRunDrift": false,
  "baselineStrategy": "hybrid",
  "gate": {
    "mode": "style-only",
    "pixelScriptPrefixes": ["intent/"]
  },
  "ignoreRegions": [],
  "maskSelectors": [
    { "selector": ".ant-badge-count, .ant-scroll-number, .ant-badge-dot" },
    { "selector": ".ant-avatar, [class*='avatar']" },
    { "selector": "time, .ant-statistic-content, [class*='datetime'], [class*='DateTime']" },
    { "selector": ".ant-pagination, .advanced-table-footer" },
    { "selector": ".ant-table-tbody" },
    { "selector": "canvas, [class*='chart'], [class*='Chart']" }
  ],
  "viewports": [
    { "name": "desktop", "width": 1280, "height": 720, "default": true },
    { "name": "mobile", "width": 375, "height": 812, "enabled": false }
  ],
  "structureChecks": {
    "enabled": true,
    "bboxTolerancePx": 4,
    "failOnOverflow": true,
    "failOnPageError": false,
    "checkDomHash": false,
    "domHashRoot": "body",
    "items": [
      {
        "key": "intent-approve-table",
        "selector": ".ant-table, table",
        "script": "intent/dev/审批列表页可见",
        "required": true
      },
      {
        "key": "intent-approve-tabs",
        "selector": ".ant-tabs, [role='tablist']",
        "script": "intent/dev/审批列表页可见",
        "required": true
      },
      {
        "key": "intent-approve-toolbar",
        "selector": ".ant-input-affix-wrapper, .ant-input-search, .ant-input",
        "script": "intent/dev/审批列表页可见",
        "required": false
      },
      {
        "key": "golden-login-workbench-tab",
        "selector": "[role='tab']",
        "script": "stage/golden-set/01-login",
        "frame": "first",
        "required": true,
        "snapshotName": "home"
      },
      {
        "key": "golden-login-side-menu",
        "selector": ".ant-menu, [role='menu']",
        "script": "stage/golden-set/01-login",
        "frame": "first",
        "required": true,
        "snapshotName": "home"
      },
      {
        "key": "golden-dashboard-workbench-tab",
        "selector": "[role='tab']",
        "script": "stage/golden-set/02-dashboard",
        "frame": "first",
        "required": true,
        "snapshotName": "dashboard"
      },
      {
        "key": "golden-dashboard-side-menu",
        "selector": ".ant-menu, [role='menu']",
        "script": "stage/golden-set/02-dashboard",
        "frame": "first",
        "required": true,
        "snapshotName": "dashboard"
      },
      {
        "key": "golden-approve-table",
        "selector": ".ant-table, table",
        "script": "stage/golden-set/03-approval-list",
        "frame": "first",
        "required": false,
        "snapshotName": "approval-list"
      },
      {
        "key": "golden-approve-tabs",
        "selector": ".ant-tabs, [role='tablist']",
        "script": "stage/golden-set/03-approval-list",
        "frame": "first",
        "required": false,
        "snapshotName": "approval-list"
      }
    ]
  },
  "styleChecks": {
    "enabled": true,
    "tolerance": {
      "fontSizePx": 0,
      "colorDelta": 3
    },
    "items": [
      {
        "key": "intent-approve-primary-btn",
        "selector": ".ant-btn-primary, .ant-input-search-button",
        "label": "主按钮",
        "props": ["backgroundColor", "color", "fontSize", "borderRadius"],
        "required": true,
        "script": "intent/dev/审批列表页可见"
      },
      {
        "key": "intent-approve-table-head",
        "selector": ".ant-table-thead th",
        "label": "表格表头",
        "props": ["backgroundColor", "color", "fontSize", "fontWeight"],
        "required": true,
        "script": "intent/dev/审批列表页可见"
      },
      {
        "key": "intent-approve-tab-active",
        "selector": ".ant-tabs-tab-active",
        "label": "页签选中态",
        "props": ["color", "fontSize", "fontWeight"],
        "required": true,
        "script": "intent/dev/审批列表页可见"
      },
      {
        "key": "intent-approve-input",
        "selector": ".ant-input-affix-wrapper, .ant-input",
        "label": "输入框",
        "props": ["borderColor", "fontSize", "color"],
        "required": true,
        "script": "intent/dev/审批列表页可见"
      },
      {
        "key": "golden-login-workbench-tab",
        "selector": "[role='tab']",
        "label": "工作台 Tab",
        "props": ["color", "fontSize", "fontWeight"],
        "required": false,
        "script": "stage/golden-set/01-login",
        "frame": "first",
        "snapshotName": "home"
      },
      {
        "key": "golden-dashboard-workbench-tab",
        "selector": "[role='tab']",
        "label": "工作台 Tab",
        "props": ["color", "fontSize", "fontWeight"],
        "required": false,
        "script": "stage/golden-set/02-dashboard",
        "frame": "first",
        "snapshotName": "dashboard"
      },
      {
        "key": "golden-approve-primary-btn",
        "selector": ".ant-btn-primary, .ant-input-search-button",
        "label": "主按钮",
        "props": ["backgroundColor", "color", "fontSize", "borderRadius"],
        "required": false,
        "script": "stage/golden-set/03-approval-list",
        "frame": "first",
        "snapshotName": "approval-list"
      },
      {
        "key": "golden-approve-table-head",
        "selector": ".ant-table-thead th",
        "label": "表格表头",
        "props": ["backgroundColor", "color", "fontSize", "fontWeight"],
        "required": false,
        "script": "stage/golden-set/03-approval-list",
        "frame": "first",
        "snapshotName": "approval-list"
      }
    ]
  },
  "aiReview": {
    "enabled": false,
    "minSeverity": "warning",
    "maxItems": 20,
    "failOnUiBug": false
  },
  "screenshot": {
    "freezeAnimations": true,
    "deviceScaleFactor": 1,
    "fullPage": false
  },
  "autoPromote": {
    "maxDiffRatio": 0.005
  },
  "crossBrowser": {
    "blockerRatio": 0.03,
    "warningRatio": 0.003,
    "countAsBlockerInGate": false,
    "pixelmatchThreshold": 0.1,
    "includeAA": false
  },
  "diffRegions": {
    "enabled": true,
    "highRatio": 0.002,
    "highMinWidth": 80,
    "highMinHeight": 40,
    "lowMaxPixels": 40
  }
}
