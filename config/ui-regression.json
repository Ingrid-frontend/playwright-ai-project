{
  "blockerRatio": 0.005,
  "warningRatio": 0.001,
  "diffOnlyTabMinRatio": 0.003,
  "defaultBrowsers": ["chrome"],
  "compareCrossBrowser": false,
  "compareRunDrift": false,
  "baselineStrategy": "golden",
  "gate": {
    "mode": "style-only"
  },
  "ignoreRegions": [],
  "maskSelectors": [
    {
      "selector": ".ant-badge-count, .ant-scroll-number, .ant-badge-dot",
      "script": "260612/我的审批_2026-06-09_16-48-19"
    },
    {
      "selector": ".ant-avatar, [class*='avatar']",
      "script": "260612/我的审批_2026-06-09_16-48-19"
    },
    {
      "selector": "time, .ant-statistic-content, [class*='datetime'], [class*='DateTime']",
      "script": "260612/我的审批_2026-06-09_16-48-19"
    }
  ],
  "viewports": [
    { "name": "desktop", "width": 1280, "height": 720, "default": true },
    { "name": "mobile", "width": 375, "height": 812, "enabled": false }
  ],
  "structureChecks": {
    "enabled": true,
    "bboxTolerancePx": 4,
    "failOnOverflow": true,
    "failOnPageError": false,
    "checkDomHash": true,
    "domHashRoot": "body",
    "items": [
      {
        "key": "html",
        "selector": "html",
        "script": "260612/我的审批_2026-06-09_16-48-19",
        "required": true
      },
      {
        "key": "main-iframe",
        "selector": "iframe",
        "script": "260612/我的审批_2026-06-09_16-48-19",
        "required": false
      },
      {
        "key": "approve-table",
        "selector": ".ant-table, table",
        "script": "260612/我的审批_2026-06-09_16-48-19",
        "frame": "first",
        "required": false
      },
      {
        "key": "approve-tabs",
        "selector": ".ant-tabs, [role='tablist']",
        "script": "260612/我的审批_2026-06-09_16-48-19",
        "frame": "first",
        "required": false
      }
    ]
  },
  "styleChecks": {
    "enabled": true,
    "tolerance": {
      "fontSizePx": 0,
      "colorDelta": 0
    },
    "items": [
      {
        "key": "primary-btn",
        "selector": "#primary-btn",
        "label": "主按钮",
        "props": ["backgroundColor", "color", "fontSize", "borderRadius"],
        "required": true,
        "script": "mock/style-drift-demo"
      },
      {
        "key": "page-title",
        "selector": "#page-title",
        "label": "页面标题",
        "props": ["color", "fontSize", "fontWeight"],
        "required": true,
        "script": "mock/style-drift-demo"
      },
      {
        "key": "list-card",
        "selector": ".list-card",
        "label": "列表卡片",
        "props": ["backgroundColor", "borderRadius", "boxShadow"],
        "required": false,
        "script": "mock/style-drift-demo"
      }
    ]
  },
  "aiReview": {
    "enabled": false,
    "minSeverity": "warning",
    "maxItems": 20,
    "failOnUiBug": false
  },
  "screenshot": {
    "freezeAnimations": true,
    "deviceScaleFactor": 1,
    "fullPage": false
  },
  "autoPromote": {
    "maxDiffRatio": 0.005
  },
  "crossBrowser": {
    "blockerRatio": 0.03,
    "warningRatio": 0.003,
    "countAsBlockerInGate": false,
    "pixelmatchThreshold": 0.1,
    "includeAA": false
  },
  "diffRegions": {
    "enabled": true,
    "highRatio": 0.002,
    "highMinWidth": 80,
    "highMinHeight": 40,
    "lowMaxPixels": 40
  }
}
