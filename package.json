    "expense-flow:write": "tsx scripts/flow/run-expense-flow-write.ts",
    "expense-flow:stability-gate": "tsx scripts/flow/run-expense-flow-stability-gate.ts",
    "prune:flow-videos": "tsx scripts/report/prune-flow-videos.ts",
    "prune:flow-history": "tsx scripts/report/prune-flow-history.ts"
