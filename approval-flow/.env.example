# 被测环境地址（登录页或首页）
BASE_URL=https://dev.huilianyi.com

# 可选：复用主仓库已导出的登录态，避免再走账号密码
# STORAGE_STATE=../storage/loginState/dev.json

# 登录账号（不填则跳过需要登录的用例）
LOGIN_USERNAME=
LOGIN_PASSWORD=

# 可选：登录页路径，默认 /login
# LOGIN_PATH=/login

# 可选：指定一条「待审批」单号用于搜索+打开/审批（不填则用列表第一条）
# APPROVAL_DOC_NO=BX-2026-000123

# 可选：指定一条用于「驳回」的单号（不填则用通过操作后的下一条待审批）
# REJECT_DOC_NO=BX-2026-000124

# 审批意见文案（通过 / 驳回）
APPROVAL_COMMENT=自动化审批通过（Playwright）
REJECT_COMMENT=自动化审批驳回（Playwright）

# 写操作开关；不设为 1 时「通过 / 驳回」用例 skip，避免消耗待审批
# APPROVAL_ENABLE_WRITE=1
