# 被测环境地址
BASE_URL=https://dev.huilianyi.com

# 可选：复用主仓库已导出的登录态
# STORAGE_STATE=../storage/loginState/dev.json

LOGIN_USERNAME=
LOGIN_PASSWORD=

# 可选：指定单号用于搜索/打开（fix-approver 脚本必填）
# REQUEST_DOC_NO=EA1144499145925038250

# 新建时指定单据名称（不填则选第一个；含「自选审批人」的表单需再配 REQUEST_APPROVER 或依赖自动选第一人）
# REQUEST_FORM_NAME=费用申请单

# 自选审批人：填选人弹窗里能搜到的中文名/工号（账号 97dev 常搜不到）
# REQUEST_APPROVER=你的中文名

# 新建单据事由；不设则每次随机（自动化申请单事由-时间戳-四位）
# REQUEST_REASON=自动化申请单事由（Playwright）

# 写操作开关；不设为 1 时「新建/保存/提交」、fix-approver、submit-then-approve 用例 skip
# REQUEST_ENABLE_WRITE=1

# 串联审批意见（submit-then-approve）
# APPROVAL_COMMENT=自动化审批通过（Playwright）
# REJECT_COMMENT=自动化审批驳回（Playwright）

# ---------- 单独跑：撤回 + 改自选审批人 ----------
# 仓库根目录：
#   REQUEST_ENABLE_WRITE=1 REQUEST_DOC_NO=EA1144499145925038250 \
#     npx playwright test -c request-flow/playwright.config.ts request-flow/tests/request/fix-approver.spec.ts
# request-flow 目录：
#   REQUEST_ENABLE_WRITE=1 REQUEST_DOC_NO=EA... npm run test:fix-approver

# ---------- 单独跑：提交 → 审批通过 / 驳回（造 2 张单） ----------
#   REQUEST_ENABLE_WRITE=1 REQUEST_APPROVER=97dev \
#     npx playwright test -c request-flow/playwright.config.ts request-flow/tests/request/submit-then-approve.spec.ts
#   或：REQUEST_ENABLE_WRITE=1 npm run test:submit-approve
# Studio：申请单流程 → 快捷「提交后审批」→ 勾选写操作 → 运行
