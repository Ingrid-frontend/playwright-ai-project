# 环境变量配置模板
# 复制此文件为 .env 并填入真实的值

# 环境选择（dev / uat / stage9084 / stage）
# 推荐使用 PLAYWRIGHT_ENV；兼容旧的 NODE_ENV
PLAYWRIGHT_ENV=stage

# 测试账号信息（可选，如果配置了 datasource/accounts.json 则优先使用配置文件）
TEST_USERNAME=your-account@example.com
TEST_PASSWORD=your-password

# 其他配置
CI=false

# ── 飞书通知（可选） ──
# 优先：自建应用 IM（应用机器人需已入群）
FEISHU_CHAT_ID=
# 次选：群自定义机器人 Webhook
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-url
# 可选：Webhook 签名校验
FEISHU_WEBHOOK_SECRET=

# ── 飞书卡片交互按钮（可选，需公网端点） ──
# 回调 URL（需公网可访问）
FEISHU_CALLBACK_URL=
# 报告 URL（配置后卡片底部会显示「查看报告」按钮）
FEISHU_REPORT_URL=
# 飞书开放平台 Verification Token
FEISHU_VERIFICATION_TOKEN=

# ── 飞书开放平台应用（可选，用于创建飞书文档 / 多维表） ──
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── 飞书多维表（可选，用于质量看板） ──
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_RUN_TABLE_ID=
FEISHU_BITABLE_ISSUE_TABLE_ID=
FEISHU_BITABLE_DAILY_SUMMARY_TABLE_ID=
# 仪表盘 URL（含 block=blk...，创建后运行 npm run feishu:bitable-setup 获取）
FEISHU_BITABLE_DASHBOARD_URL=

# ── Figma 设计稿对比（Studio 界面） ──
# Figma Personal Access Token，用于导出设计稿 PNG 与读取设计节点 JSON（规范抽取）
FIGMA_TOKEN=

# ── AI 原生用例生成/执行（Explore / 口语试跑 / NL→YAML / Intent 自愈）──
# 固定 AI_TEST_PROVIDER + AI_TEST_MODEL，勿随试跑临时改，减少 Intent YAML 漂移
# 默认 deepseek，火山方舟等 OpenAI 兼容接口用 openai
AI_TEST_PROVIDER=
# 固定模型：方舟填 ep-xxxxxxxx 或 ark-code-latest；改 .env 后需重启 Studio
AI_TEST_MODEL=
AI_TEST_DEEPSEEK_API_KEY=
AI_TEST_ANTHROPIC_API_KEY=
AI_TEST_OPENAI_API_KEY=
AI_TEST_DEEPSEEK_BASE_URL=
AI_TEST_OPENAI_BASE_URL=
# 火山方舟示例（OpenAI 兼容）：
# AI_TEST_PROVIDER=openai
# AI_TEST_OPENAI_API_KEY=你的方舟 API Key
# AI_TEST_MODEL=ep-xxxxxxxx-xxxxx
# AI_TEST_OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 执行失败时是否允许模型尝试单步自愈
AI_TEST_HEAL=0
