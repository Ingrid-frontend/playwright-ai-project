# 环境变量配置模板
# 复制此文件为 .env 并填入真实的值

# 环境选择（dev / uat / stage9084 / stage）
# 推荐使用 PLAYWRIGHT_ENV；兼容旧的 NODE_ENV
# 各环境差异（标签、交付路径、跨浏览器默认开关）见 config/env-profiles.json
PLAYWRIGHT_ENV=stage

# 跨浏览器截图对比（Chrome vs WebKit）。优先级：本变量 > env-profiles > ui-regression.json
# dev 默认开启；stage9084 / stage 默认关闭
# PLAYWRIGHT_COMPARE_CROSS_BROWSER=1

# 测试账号信息（可选，如果配置了 datasource/accounts.json 则优先使用配置文件）
TEST_USERNAME=your-account@example.com
TEST_PASSWORD=your-password

# 其他配置
CI=false

# ── 飞书通知（可选） ──
# 优先：自建应用 IM（应用机器人需已入群）
# 内部群（日汇总/告警/交付留档）；未设 FEISHU_CHAT_ID_INTERNAL 时用本值兜底
FEISHU_CHAT_ID=
# 客户交付群（仅正式交付卡片）；缺省不回退内部群，留空即跳过客户卡
FEISHU_CHAT_ID_CUSTOMER=
# 内部群专用（可选，留空则回退到 FEISHU_CHAT_ID）
FEISHU_CHAT_ID_INTERNAL=
# 次选：群自定义机器人 Webhook
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-url
# 可选：Webhook 签名校验
FEISHU_WEBHOOK_SECRET=

# ── 飞书卡片交互按钮（可选，需公网端点） ──
# 回调 URL（需公网可访问）
FEISHU_CALLBACK_URL=
# 报告 URL（配置后卡片底部会显示「查看报告」按钮）
FEISHU_REPORT_URL=
# 飞书开放平台 Verification Token
FEISHU_VERIFICATION_TOKEN=

# ── 飞书开放平台应用（可选，用于创建飞书文档 / 多维表） ──
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── 飞书多维表（可选，用于质量看板） ──
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_RUN_TABLE_ID=
FEISHU_BITABLE_ISSUE_TABLE_ID=
FEISHU_BITABLE_DAILY_SUMMARY_TABLE_ID=
FEISHU_BITABLE_FEEDBACK_TABLE_ID=
# 仪表盘 URL（含 block=blk...，创建后运行 npm run feishu:bitable-setup 获取）
FEISHU_BITABLE_DASHBOARD_URL=


# ── AI 原生用例生成/执行（Explore / 口语试跑 / NL→YAML / Intent 自愈）──
# 固定 AI_TEST_PROVIDER + AI_TEST_MODEL，勿随试跑临时改，减少 Intent YAML 漂移
# 默认 deepseek，火山方舟等 OpenAI 兼容接口用 openai
AI_TEST_PROVIDER=
# 固定模型：方舟填 ep-xxxxxxxx 或 ark-code-latest；改 .env 后需重启 Studio
AI_TEST_MODEL=
AI_TEST_DEEPSEEK_API_KEY=
AI_TEST_ANTHROPIC_API_KEY=
AI_TEST_OPENAI_API_KEY=
AI_TEST_DEEPSEEK_BASE_URL=
AI_TEST_OPENAI_BASE_URL=
# 火山方舟示例（OpenAI 兼容）：
# AI_TEST_PROVIDER=openai
# AI_TEST_OPENAI_API_KEY=你的方舟 API Key
# AI_TEST_MODEL=ep-xxxxxxxx-xxxxx
# AI_TEST_OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 执行失败时是否允许模型尝试单步自愈
AI_TEST_HEAL=0

# ── AI UI 审计（Layer 1 单图结构化审计，npm run ui-audit）──
# 走 OpenAI 兼容的 /chat/completions（image_url 内联 base64），任何兼容网关都能接。
# 留空则自动回退到上面的 AI_TEST_OPENAI_* / OPENAI_*；全都没有时降级为 mock 规则分析。
AI_API_KEY=
AI_BASE_URL=
# 留空则回退 AI_TEST_MODEL（文本模型不保证支持图像；不支持时接口报错并降级为规则分析）
AI_VISION_MODEL=
# 视觉接口超时毫秒；双图 Figma 对比默认 180s，单图 120s
# AI_VISION_TIMEOUT_MS=180000
# 视觉接口失败重试次数（默认 1，即最多 2 次请求）；超时不再重试
# AI_VISION_RETRIES=1
# 送模型的截图最大宽度，超出则降采样（默认 1280）；0=不降采样
# AI_VISION_MAX_WIDTH=1280
# 并行审计步数（默认 2）；1=串行
# UI_AUDIT_CONCURRENCY=2
# 1=强制 mock（不调用 AI，用于自检）；0=强制真跑；留空=无 Key 时自动降级
AI_AUDIT_MOCK=
# 1=双图 Figma 视觉对比（慢、易超时）；默认 0=Helios/Figma 文本规范 + 单图
# AI_AUDIT_FIGMA_VISION=0

# ── 前端仓库同步（探活前 SSH pull + 重建 ui-contract 索引）──
# SSH 地址（推荐）；Studio 输入框可覆盖
FRONTEND_REPO_SSH_URL=gogsio@code.huilianyi.com:huilianyi/huilianyi-refactoring.git
# 分支按 Playwright 环境自动选择：dev→hly-deploy，uat→hly-dev，stage/stage9084→hly-release
# 强制指定全环境同一分支时取消注释：
# FRONTEND_REPO_BRANCH=hly-dev
# 指定 SSH 私钥（可选，默认用 ~/.ssh 里匹配的密钥）
# FRONTEND_REPO_SSH_COMMAND=ssh -i ~/.ssh/id_ed25519 -o StrictHostKeyChecking=accept-new
# 无远程地址时的本地仓库回退路径（可选）
# FRONTEND_REPO_LOCAL=/path/to/local/frontend-repo
# HTTPS 备用（需 FRONTEND_REPO_TOKEN）
# FRONTEND_REPO_URL=https://code.huilianyi.com/huilianyi/huilianyi-refactoring.git
# FRONTEND_REPO_TOKEN=

# ── Figma 设计稿基准（可选，AI UI 审计对照用）──
# 个人 Access Token，用于拉取 node 导出图。不配仍可走文本规范审计（映射 + Helios）。
# Figma 设计稿（仅 sync 时需要；日常 ui-audit 只读本地 screenshots-baseline/figma/）
# FIGMA_ACCESS_TOKEN=
# 同步：npm run figma:sync-baselines

