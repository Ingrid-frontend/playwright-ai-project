{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "playwright.config.ts",
    "utils/**/*",
    "scripts/**/*",
    "custom-reporters/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/ai-generated",
    "tests/optimized",
    "tests/raw-recordings",
    "tests/deprecated",
    "tests/chrome-recorder"
  ]
}
